venv/
.venv/
node_modules/
services/node_modules/
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/
.env
.env.bak.*
# Secrets: keep plaintext and every transient secrets.env variant out of
# the build context. If an encrypted secrets.env is used, it is mounted
# at runtime — never baked into the image. Mirrored in .gitignore.
secrets.env
secrets.env.*
secrets.env~
.secrets.env.swp
.secrets.env.swo
**/#secrets.env#
!secrets.env.example
/data/
/logs/
.git/
.claude/
.playwright-mcp/
.pytest_cache/
.vscode/
.idea/
dev-docs/
docs/
*.md
*.db
*.sqlite
*.sqlite3
/reports/
/research_data/
tasks/
_scratch/
compound.config.json
search_analytics.json
**/search_analytics.json
tests/
api/
*.log
*.error.log
chart.png
timetree*.png
*_signin_page.png
*_calendar_view.png
.gitignore
.env.save
.env.prod

# P0 security: exclude local and secret data
.env.*
*.backup-*
*.bak
*.bak-*
data/
logs/

# Recursive generated/intermediate files.
# Dockerignore matching is made explicit with ** so nested Python caches
# and local backup files can never reach COPY . .
**/__pycache__/
**/*.pyc
**/*.pyo
**/*.bak
**/*.bak-*
**/*.backup-*
**/*.swp
**/*.swo
**/*~

# Host/development material: these files may remain in the repository or
# working tree, but they are never application runtime inputs.
#
# Docker Compose reads compose files on the host before the build context is
# sent, so excluding them here does not prevent `docker compose build`.
/docker-compose*.yml
/compose.expandido.yml

# Local experiments / abandoned runtime candidates.
/api02.py
/src/main.py

# Local historical/patch material; never bake into the application image.
/legacy/
/local-patches/
/requirements.broken.txt
